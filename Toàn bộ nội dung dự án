\chapter{MÔ HÌNH HÓA THỰC TẾ VÀ CÔNG CỤ TRỰC QUAN}

\paragraph{BÀI 1: Bài toán So sánh Hiệu quả Đầu tư vs Gửi tiết kiệm Lãi kép}
\textbf{Đề bài:} Ngày 18/4/2022, cô Bình mua $10.000$ cổ phiếu với giá $21.000$ đồng/cp. Đến ngày 18/4/2023, cô bán toàn bộ số cổ phiếu đó với giá $27.000$ đồng/cp.
\begin{enumerate}[label=\alph*)]
    \item Tính số tiền lãi cô Bình nhận được sau khi bán.
    \item Giả sử ngày 18/4/2022 cô gửi số tiền đầu tư đó vào ngân hàng kỳ hạn 12 tháng với lãi suất $6{,}3\%$/năm. Tính số tiền lãi tiết kiệm nhận được vào ngày 18/4/2023. Từ đó so sánh hai phương án.
\end{enumerate}

\textbf{Lời giải chi tiết:}
\begin{enumerate}[label=\alph*)]
    \item \textbf{Phương án đầu tư chứng khoán:}
    \begin{itemize}
        \item Số tiền vốn ban đầu cô Bình bỏ ra mua cổ phiếu:
        \[
        10.000 \times 21.000 = 210.000.000 \text{ (đồng)}
        \]
        \item Số tiền thu về sau khi bán cổ phiếu sau 1 năm:
        \[
        10.000 \times 27.000 = 270.000.000 \text{ (đồng)}
        \]
        \item Số tiền lãi từ đầu tư chứng khoán:
        \[
        270.000.000 - 210.000.000 = 60.000.000 \text{ (đồng)}
        \]
    \end{itemize}

    \item \textbf{Phương án gửi tiết kiệm ngân hàng:}
    \begin{itemize}
        \item Số tiền lãi nhận được từ ngân hàng sau 1 năm (kỳ hạn 12 tháng) với số vốn $210.000.000$ đồng:
        \[
        T_{\text{lãi}} = 210.000.000 \times 6{,}3\% = 13.230.000 \text{ (đồng)}
        \]
    \end{itemize}
\end{enumerate}

\textbf{So sánh kết quả:}
\begin{itemize}
    \item Số tiền lãi từ đầu tư chứng khoán cao hơn gửi tiết kiệm ngân hàng:
    \[
    60.000.000 - 13.230.000 = 46.770.000 \text{ (đồng)}
    \]
    \item \textbf{Kết luận tài chính:} Trong giai đoạn này, phương án Đầu tư chứng khoán hiệu quả hơn gửi tiết kiệm, mang lại mức lợi nhuận vượt trội gấp gần 4,5 lần. Tuy nhiên, đi kèm với đó là rủi ro biến động giá cổ phiếu trên thị trường (như đã rút ra ở nhận xét lý thuyết của bài học).
\end{itemize}


\paragraph{BÀI 2: Phân bổ Ngân sách Gia đình}
\textbf{Đề bài:} Gia đình anh Nam dự kiến phân bổ các khoản chi tiêu hàng tháng bao gồm: Chi cho nhu cầu thiết yếu; Chi cho tiết kiệm và đầu tư; Chi cho mua sắm cá nhân; Chi cho học tập của các con, dịch vụ y tế và chăm sóc sức khỏe. Hãy xác định tỷ lệ phần trăm hợp lý cho từng khoản mục theo quy tắc 50/20/30.

\textbf{Lời giải và Biện luận Toán học:}
\begin{itemize}
    \item Theo lý thuyết tài chính cá nhân vĩ mô, tổng nhóm chi tiêu linh hoạt (Mua sắm + Học tập, y tế) phải nằm trong giới hạn 30\%. Dựa trên số liệu khảo sát thực tế của bài học, ngân sách được phân rã như sau:
    \begin{itemize}
        \item \textbf{Khoản 1:} Nhu cầu thiết yếu (Cố định): Chiếm $50\%$ tổng thu nhập.
        \item \textbf{Khoản 2:} Tiết kiệm và đầu tư (Tích sản): Chiếm $20\%$ tổng thu nhập.
        \item \textbf{Khoản 3:} Mua sắm cá nhân: Phân bổ $14\%$ tổng thu nhập.
        \item \textbf{Khoản 4:} Học tập, y tế, sức khỏe: Phân bổ $16\%$ tổng thu nhập.
    \end{itemize}
    \item \textbf{Kiểm tra tính hợp lý:}
    \[
    14\% \text{ (Mua sắm)} + 16\% \text{ (Học tập, y tế)} = 30\% \text{ (Thuộc nhóm Linh hoạt)}
    \]
    \[
    \text{Tổng cộng} = 50\% + 20\% + 14\% + 16\% = 100\%
    \]
    \item \textbf{Kết luận:} Phương án phân bổ của gia đình anh Nam hoàn toàn hợp lý và tuân thủ nghiêm ngặt mô hình 50/20/30, đảm bảo được cả hai yếu tố: an sinh hiện tại (y tế, giáo dục) và tích lũy số mũ cho tương lai.
\end{itemize}


\paragraph{BÀI 3: Tính Tiền lương Thực tế và Sức mua}
\textbf{Đề bài:} Năm 2020, tiền lương của một kỹ sư là $15.000.000 \text{ VND/tháng}$. Năm 2021, tiền lương danh nghĩa tăng lên $16.200.000 \text{ VND/tháng}$. Biết tỷ lệ lạm phát của năm 2021 là $3{,}2\%$. Tính tiền lương thực tế năm 2021 của kỹ sư đó và đánh giá sức mua thay đổi thế nào so với năm 2020.

\textbf{Lời giải chi tiết:}
\begin{itemize}
    \item \textbf{Bước 1: Xác định bản chất số liệu}
    \begin{itemize}
        \item Lương danh nghĩa năm 2021 ($L_{\text{dn}}$): $16.200.000 \text{ (đồng)}$
        \item Tỷ lệ lạm phát năm 2021 ($I$): $3{,}2\% = 0{,}032$
    \end{itemize}

    \item \textbf{Bước 2: Áp dụng công thức tính Tiền lương thực tế ($L_{\text{tt}}$)}
    \[
    L_{\text{tt}} = \frac{L_{\text{dn}}}{1 + I} = \frac{16.200.000}{1 + 0{,}032} = \frac{16.200.000}{1{,}032} \approx 15.697.674 \text{ (VND)}
    \]

    \item \textbf{Bước 3: So sánh sức mua thực tế với năm 2020}
    \[
    15.697.674 - 15.000.000 = 697.674 \text{ (VND)}
    \]

    \item \textbf{Kết luận tài chính:} Mặc dù trên giấy tờ (danh nghĩa) tiền lương của kỹ sư tăng thêm $1.200.000 \text{ VND}$, nhưng do giá cả hàng hóa ngoài thị trường đã tăng lên $3{,}2\%$, nên mức tăng trưởng sức mua thực tế của lượng tiền đó chỉ tương đương $697.674 \text{ VND}$ so với năm trước.
\end{itemize}
